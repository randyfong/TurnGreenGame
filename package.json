{
  "name": "cooltown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:live": "node --import tsx scripts/validate-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "6.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
